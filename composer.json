{
    "name": "glueful/commerce",
    "description": "Commerce primitives for Glueful apps: products, carts, orders, inventory, discounts, checkout, and payment integration.",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "commerce",
        "cart",
        "checkout",
        "orders",
        "inventory",
        "discounts"
    ],
    "require": {
        "php": "^8.3",
        "glueful/extension-contracts": "^1.5.0"
    },
    "require-dev": {
        "glueful/framework": "^1.71.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\Commerce\\": "src/"
        },
        "classmap": [
            "migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\Commerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpcs": "vendor/bin/phpcs --standard=PSR12 src",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR12 src",
        "analyze": "vendor/bin/phpstan analyze src --level=5"
    },
    "extra": {
        "glueful": {
            "name": "Commerce",
            "displayName": "Commerce",
            "description": "Commerce primitives for products, carts, orders, inventory, discounts, checkout, and payments.",
            "version": "1.8.0",
            "icon": "assets/icon.png",
            "galleryBanner": {
                "color": "#0F766E",
                "theme": "dark"
            },
            "categories": [
                "commerce",
                "checkout",
                "orders"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\Commerce\\CommerceServiceProvider",
            "requires": {
                "glueful": ">=1.71.0",
                "extensions": []
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "glueful/extensions": true
        },
        "sort-packages": true
    }
}
